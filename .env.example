# dropbox-docker environment variables
# Copy to .env and customize: cp .env.example .env
# https://github.com/islamdiaa/dropbox-docker

# --- Identity ---
# Match these to the owner of your sync folder
DROPBOX_UID=1000
DROPBOX_GID=1000
TZ=UTC

# --- Behavior ---
# Skip recursive chown on startup (recommended for large accounts)
SKIP_SET_PERMISSIONS=true
# Set to any value to skip pulling the latest Dropbox binary on start
# DROPBOX_SKIP_UPDATE=1
# Seconds between status checks and temp file cleanup
POLLING_INTERVAL=5
# How to repair file ownership in the sync folder:
#   full       - chown files not owned by DROPBOX_UID (default)
#   group-only - only set the group to DROPBOX_GID, keep each file's owner
#   disabled   - never change ownership in the sync folder
OWNERSHIP_FIX_MODE=full
# Seconds between scheduled ownership repair passes (also runs at startup
# and when Dropbox reports a file it can't sync)
OWNERSHIP_FIX_INTERVAL=86400

# --- Reliability ---
# Max daemon restart attempts before container gives up
DROPBOX_MAX_RESTARTS=5
# Seconds between restart attempts
DROPBOX_RESTART_DELAY=10
# Seconds to wait for daemon initialization (increase for large accounts)
DROPBOX_STARTUP_TIMEOUT=300

# --- Monitoring ---
# Set to true to enable Prometheus metrics on port 8000
ENABLE_MONITORING=false
